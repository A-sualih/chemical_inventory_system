{
  "expo": {
    "name": "CIMS Mobile",
    "slug": "cims-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e141b"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cims.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan chemical barcodes and QR codes for inventory lookup and stock actions.",
        "NSPhotoLibraryUsageDescription": "Upload branding images for system settings."
      }
    },
    "android": {
      "package": "com.cims.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0e141b",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CIMS to scan barcodes and QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CIMS to upload branding images for system settings."
        }
      ],
      "expo-document-picker",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
